#ifndef TYPES_GSL
#define TYPES_GSL

#define int8 int8_t
#define uint8 uint8_t
#define int16 int16_t
#define uint16 uint16_t
#define int32 int
#define uint32 uint
#define int64 int64_t
#define uint64 uint64_t

#define sbyte2 i8vec2
#define sbyte3 i8vec3
#define sbyte4 i8vec4
#define byte2 u8vec2
#define byte3 u8vec3
#define byte4 u8vec4
#define short2 i16vec2
#define short3 i16vec3
#define short4 i16vec4
#define ushort2 u16vec2
#define ushort3 u16vec3
#define ushort4 u16vec4
#define long2 i64vec2
#define long3 i64vec3
#define long4 i64vec4
#define ulong2 u64vec2
#define ulong3 u64vec3
#define ulong4 u64vec4

#define float2 vec2
#define float3 vec3
#define float4 vec4
#define double2 dvec2
#define double3 dvec3
#define double4 dvec4
#define int2 ivec2
#define int3 ivec3
#define int4 ivec4
#define uint2 uvec2
#define uint3 uvec3
#define uint4 uvec4
#define bool2 bvec2
#define bool3 bvec3
#define bool4 bvec4

#define float2x2 mat2
#define float3x3 mat3
#define float4x4 mat4
#define float2x3 mat2x3
#define float3x2 mat3x2
#define float2x4 mat2x4
#define float4x2 mat4x2
#define float3x4 mat3x4
#define float4x3 mat4x3

#define half float16_t
#define half2 f16vec2
#define half3 f16vec3
#define half4 f16vec4
#define half2x2 f16mat2
#define half3x3 f16mat3
#define half4x4 f16mat4
#define half2x3 f16mat2x3
#define half3x2 f16mat3x2
#define half2x4 f16mat2x4
#define half4x2 f16mat4x2
#define half3x4 f16mat3x4
#define half4x3 f16mat4x3

#ifndef Color
#define Color byte4
#endif

//**********************************************************************************************************************
#define printf debugPrintfEXT
#define saturate(x) clamp(x, 0.0, 1.0)
#define lerp(x, y, a) mix(x, y, a)
#define mad(a, b, c) fma(a, b, c)
#define rsqrt(x) inversesqrt(x)
#define frac(x) fract(x)

#define ddx(p) dFdx(p)
#define ddy(p) dFdy(p)
#define ddx_fine(p) dFdxFine(p)
#define ddy_fine(p) dFdyFine(p)
#define ddx_coarse(p) dFdxCoarse(p)
#define ddy_coarse(p) dFdyCoarse(p)

uint16 packUnorm2x8(float2 x)
{
	ushort2 u = ushort2(fma(saturate(x), float2(255.0f), float2(0.5f)));
	return u.x | (u.y << 8u);
}
float2 unpackUnorm2x8(uint16 x) { return float2(x & 255u, x >> 8u) * float(1.0 / 255.0); }

uint8 quantizeUnorm8(float v) { return uint8(fma(saturate(v), 255.0f, 0.5f)); }
byte2 quantizeUnorm8(float2 v) { return byte2(fma(saturate(v), float2(255.0f), float2(0.5f))); }
byte3 quantizeUnorm8(float3 v) { return byte3(fma(saturate(v), float3(255.0f), float3(0.5f))); }
byte4 quantizeUnorm8(float4 v) { return byte4(fma(saturate(v), float4(255.0f), float4(0.5f))); }

uint16 quantizeUnorm16(float v) { return uint16(fma(saturate(v), 65535.0f, 0.5f)); }
ushort2 quantizeUnorm16(float2 v) { return ushort2(fma(saturate(v), float2(65535.0f), float2(0.5f))); }
ushort3 quantizeUnorm16(float3 v) { return ushort3(fma(saturate(v), float3(65535.0f), float3(0.5f))); }
ushort4 quantizeUnorm16(float4 v) { return ushort4(fma(saturate(v), float4(65535.0f), float4(0.5f))); }

float dequantizeUnorm8(uint8 v) { return float(v) * float(1.0 / 255.0); }
float2 dequantizeUnorm8(byte2 v) { return float2(v) * float(1.0 / 255.0); }
float3 dequantizeUnorm8(byte3 v) { return float3(v) * float(1.0 / 255.0); }
float4 dequantizeUnorm8(byte4 v) { return float4(v) * float(1.0 / 255.0); }

float dequantizeUnorm16(uint16 v) { return float(v) * float(1.0 / 65535.0); }
float2 dequantizeUnorm16(ushort2 v) { return float2(v) * float(1.0 / 65535.0); }
float3 dequantizeUnorm16(ushort3 v) { return float3(v) * float(1.0 / 65535.0); }
float4 dequantizeUnorm16(ushort4 v) { return float4(v) * float(1.0 / 65535.0); }

#endif // TYPES_GSL